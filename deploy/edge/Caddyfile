# NewTG edge（Caddy）——HTTP :80 预演 + 自签 HTTPS :443。
# TLS 证书由 Caddy internal CA 签发；浏览器首次访问需接受证书警告。
# 净室声明：本文件全新编写。

{
	# 无管理 API 暴露面。
	admin off
	# 保留 HTTP :80；显式 :443 站点使用 tls internal，不做自动跳转。
	auto_https disable_redirects
}

# gateway 上游组：轮询 + 主动健康检查（/readyz 是唯一「可服务」判据，GC-6）。
(reverse_gateway) {
	lb_policy round_robin
	health_uri /readyz
	health_interval 10s
	health_timeout 3s
	fail_duration 30s
}

(newtg_site) {
	# 中继协议：含 SSE 与 WebSocket —— 一律不压缩（破坏流式/帧边界）。
	handle /v1/* {
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}

	# Gemini 语义路径（/v1beta/models/*:embedContent 等）同样是流式/长响应
	# 候选；与 /v1/* 一样排除压缩（Area 4 F4）。
	handle /v1beta/* {
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}

	# 公开 live_feed 是 SSE（modules-08 /api/home/live-feed；M7 另加
	# /api/public/live-feed）。它虽在 /api/* 下，但压缩会缓冲/破坏事件流，
	# 因此必须先于 /api/* 声明为不压缩的显式路由（handle 互斥、先匹配先生效）。
	handle /api/home/live-feed {
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}
	handle /api/public/live-feed {
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}

	# 其余管理 API（JSON）：允许 gzip/zstd。
	handle /api/* {
		encode gzip zstd
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}

	# 就绪/存活探针经 edge 可达（运维与验收断言用），不压缩。
	handle /readyz {
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}
	handle /healthz {
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}

	# 控制台静态产物由 edge 直接托管；API/中继路由在前面的 handle 已先行匹配。
	# try_files 回退到 index.html，保证 /sign-in、/setup 等客户端路由可直接打开。
	handle {
		encode gzip zstd
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

:80 {
	import newtg_site
}

https://10.211.55.5:8443 {
	tls internal
	import newtg_site
}

https://localhost:8443 {
	tls internal
	import newtg_site
}
