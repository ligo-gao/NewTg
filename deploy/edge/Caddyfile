# NewTG edge（Caddy）——HTTP :80 预演 + 自签 HTTPS :443。
# TLS 证书由 Caddy internal CA 签发；浏览器首次访问需接受证书警告。
# 净室声明：本文件全新编写。
{
	# 无管理 API 暴露面。
	admin off
	# 保留 HTTP :80；显式 :443 站点使用 tls internal，不做自动跳转。
	auto_https disable_redirects
}

# gateway 上游组：轮询 + 主动健康检查（/readyz 是唯一「可服务」判据，GC-6）。
(reverse_gateway) {
	lb_policy round_robin
	health_uri /readyz
	health_interval 10s
	health_timeout 3s
	fail_duration 30s
}

(newtg_site) {
	# 中继协议：含 SSE 与 WebSocket —— 一律不压缩（破坏流式/帧边界）。
	handle /v1/* {
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}

	# Gemini 语义路径（/v1beta/models/*:embedContent 等）同样是流式/长响应
	# 候选；与 /v1/* 一样排除压缩（Area 4 F4）。
	handle /v1beta/* {
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}

	# Playground 会话中继（SSE）：/pg/chat/completions 与 /pg/models 由 gateway
	# 的会话身份面提供。与 /v1/* 一样不压缩，且必须先于静态 SPA 兜底——
	# 否则 POST 会落到 file_server，得到 405（Allow: GET, HEAD）。
	handle /pg/* {
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}

	# 公开 live_feed 是 SSE（modules-08 /api/home/live-feed；M7 另加
	# /api/public/live-feed）。它虽在 /api/* 下，但压缩会缓冲/破坏事件流，
	# 因此必须先于 /api/* 声明为不压缩的显式路由（handle 互斥、先匹配先生效）。
	handle /api/home/live-feed {
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}
	handle /api/public/live-feed {
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}

	# 其余管理 API（JSON）：允许 gzip/zstd。
	handle /api/* {
		encode gzip zstd
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}

	# 就绪/存活探针经 edge 可达（运维与验收断言用），不压缩。
	handle /readyz {
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}
	handle /healthz {
		reverse_proxy gateway:3000 {
			import reverse_gateway
		}
	}

	# 模型库不再跳转到营销站首页的 #models 锚点：控制台 SPA 现在有真实的
	# `/models` 路由（公开模型库页，含能力、实测性能、对比与子工具）。
	# 保留在这里会让导航栏的「模型库」永远进不到该页面，因此交给下面
	# 兜底的 SPA `handle` 处理。营销站自身对 `/#models` 的链接不受影响。

	# 官网首页：静态导出产物接管 `/` 与其自身资源；其余路径继续由控制台 SPA 处理。
	# 控制台仍保留 /sign-in、/dashboard、/pricing 等原有路由，不做 base path 迁移。
	@marketing_home path / /pricing /pricing/ /en /en/ /en/pricing /en/pricing/ /zh-TW /zh-TW/ /zh-TW/pricing /zh-TW/pricing/ /fr /fr/ /fr/pricing /fr/pricing/ /ru /ru/ /ru/pricing /ru/pricing/ /ja /ja/ /ja/pricing /ja/pricing/ /vi /vi/ /vi/pricing /vi/pricing/
	handle @marketing_home {
		encode gzip zstd
		root * /srv/marketing
		file_server
	}
	# 营销站的站点级元数据（P2-19）：robots.txt 与 sitemap.xml 由 Next 静态导出
	# 生成在 marketing 根目录。不放进这里会落到下面的 SPA 兜底，返回控制台
	# 的 index.html，爬虫拿到一页 HTML 当 robots.txt。
	@marketing_assets path /_next/* /icon.svg /og.png /index.html /robots.txt /sitemap.xml
	handle @marketing_assets {
		encode gzip zstd
		root * /srv/marketing
		file_server
	}

	# 控制台静态产物由 edge 直接托管；API/中继路由在前面的 handle 已先行匹配。
	# try_files 回退到 index.html，保证 /sign-in、/setup 等客户端路由可直接打开。
	handle {
		encode gzip zstd
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

:80 {
	@ip host 10.211.55.5
	redir @ip https://10.211.55.5:8443{uri} permanent
	import newtg_site
}

:8443 {
	tls /etc/caddy/certs/newtg.crt /etc/caddy/certs/newtg.key
	import newtg_site
}
