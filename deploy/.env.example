# NewTG 部署环境变量模板 —— 复制为 deploy/.env 后填写。
# deploy/.env 已在 .gitignore 中（绝不入库）。
#
#   cp deploy/.env.example deploy/.env
#   openssl rand -hex 32        # 为每个密钥生成独立值，逐个填入
#
# 所有口令都会被原样拼进 DATABASE_URL / DB_LOGS_DSN / REDIS_URL，
# 请只使用 URL 安全字符（推荐 hex）。缺任一密钥，docker compose 直接报错退出。

# ---- 数据面口令（必填；六项互相独立，禁止复用） ---------------------------
# 引导超级用户：仅 initdb 建库/建角色；gateway / worker / migrate 均不使用。
POSTGRES_PASSWORD=
# Redis 口令（redis-server --requirepass 与 REDIS_URL 共用）。
REDIS_PASSWORD=
# 运行时角色 newtg_app：仅 DML（gateway / worker 连接主库与日志库）。
POSTGRES_APP_PASSWORD=
# 迁移角色 newtg_migrate：唯一 DDL 账号（一次性 migrate 服务）。
POSTGRES_MIGRATE_PASSWORD=
# 备份角色 newtg_backup：只读 + pg_dump（profile ops）。
POSTGRES_BACKUP_PASSWORD=
# 保留/维护角色 newtg_retention（W10-N10/N11）：日志库分区 DROP + 审计保留/
# IP 擦除。**不得复用 POSTGRES_APP_PASSWORD**（角色与口令都必须独立）；
# 只拼进 worker 的 DB_RETENTION_DSN，不授予主库。
POSTGRES_RETENTION_PASSWORD=

# ---- 库名（可留默认） -----------------------------------------------------
POSTGRES_USER=newtg
POSTGRES_DB=newtg
POSTGRES_LOGS_DB=newtg_logs
POSTGRES_METRICS_DB=newtg_metrics

# ---- 应用侧必填密钥 -------------------------------------------------------
# CSRF 令牌 HMAC 派生 + 审计侧标识哈希；多副本必须一致。
SESSION_SECRET=
# AES-256-GCM 主密钥（32 字节 = 64 位 hex）：渠道凭证与 system_settings 密钥字段。
CREDENTIAL_ENCRYPTION_KEY=

# ---- 运行时（可留默认） ---------------------------------------------------
# 应用镜像：gateway / worker / migrate 共用同一个单二进制镜像。
# 默认与 Makefile 的 IMAGE ?= newtg/gateway:dev 对齐；`make image` 后无需改动。
NEWTG_IMAGE=newtg/gateway:dev
APP_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
TZ=UTC
# 实例标识前缀；worker 实际取 "<NODE_NAME>-worker"。gateway 副本不设，
# 由各自 hostname 区分（/admin/instances）。
NODE_NAME=newtg
# 空 = 不信任 X-Forwarded-*；生产填 edge 所在网段，禁止 0.0.0.0/0。
TRUSTED_PROXIES=
# 公开基址（可逗号分隔多个 origin，如 "https://newtg.example.com,https://api.example.com"）。
# **第一个合法 origin 是密码重置链接的基址**，务必把 https 放在第一位；
# Origin/Referer 白名单则使用其中的全部 origin。
# 注意：任务产物 URL 等场景要求单一 origin——填成逗号分隔值会让这些 URL 失效。
# 留空 = 回退到 setup 向导写入的 site.server_address；两者都为空时邮件相关功能
# 禁用（重置链接无法生成，不影响进程启动）。它同时是 Origin/Referer 白名单来源。
# 本内网示例：edge 的 HTTPS 端口是 8443（http :8080 会 301 跳到这里）。
PUBLIC_BASE_URL=https://10.211.55.5:8443
METRICS_TOKEN=
PERF_METRICS_ENABLED=true
PERF_METRICS_FLUSH_INTERVAL=5m
PERF_METRICS_RETENTION_DAYS=400

# ---- 演示模式（可选） -----------------------------------------------------
# 部署侧覆盖 site.demo.enabled：true/1 强制开启，false/0 强制关闭，
# 空 = 跟随站点设置（推荐留空，由管理面切换）。
# 该值会同时注入 gateway 与 worker，保证守卫/额度/计费与 worker 兜底结算
# 读到同一个有效值；切勿只在单个角色上设置同名变量。
NEWTG_DEMO_ENABLED=

# ---- 中国法定节假日同步（holiday_sync worker 任务） ------------------------
# 时段定价的「法定节假日按低谷 / 调休上班按工作日」依赖这张日历
# （holiday_calendar 表）。关闭后调度器跳过、手动触发返回 409
# holiday_sync_disabled；已同步的行仍参与计价——关掉的是拉取，不是使用。
# 离线部署没有出站时置 false，或改用内网镜像地址。
HOLIDAY_SYNC_ENABLED=true
# 年度 JSON 地址模板（%d = 年份）。默认是 jsDelivr 缓存的
# NateScarlet/holiday-cn（MIT，署名见 THIRD_PARTY_NOTICES.md）。
HOLIDAY_SYNC_URL_TEMPLATE=https://cdn.jsdelivr.net/gh/NateScarlet/holiday-cn@master/%d.json

# ---- 模型性能定时实测（model_perf_test worker 任务） ----------------------
# 只在 worker 执行：默认按北京时间每天 00:00 / 12:00 对全部公开对话模型
# 各测 3 轮（RUNS 钳制 1..5），全局并发 2 个模型（CONCURRENCY 钳制 1..8）。
# ENABLED=false 只关闭定时循环，管理面手动触发照常可用。
# 值非法（如 25:00、Mars/Base）会让 worker 启动失败并反复重启：校验发生在
# 启动期，而 compose 只校验语法，不校验取值。
PERF_SCHEDULE_ENABLED=true
# 下列四项只在性能页从未保存过对应设置时生效；保存一次后以页面为准。
# 间隔模式（perf.schedule.interval_hours）会忽略 PERF_SCHEDULE_TIMES。
PERF_SCHEDULE_TIMES=00:00,12:00
PERF_SCHEDULE_TIMEZONE=Asia/Shanghai
PERF_SCHEDULE_RUNS=3
PERF_SCHEDULE_CONCURRENCY=2

# ---- 传输开关（M0 同宿主隔离网，明文 + 补偿控制；离宿/托管必须收紧） ------
# disable | verify-full（verify-full 时两条 PG DSN 的 sslmode 跟随切换）。
DATABASE_TLS=disable
# 留空 = redis://（M0 默认）；填 on = rediss://。
# 注意 compose 用 ${REDIS_TLS:+s} 判断（非空即生效），因此不要填 off。
REDIS_TLS=
# edge 最低 TLS 版本；M0 不启用 TLS，取值保留给 M7。
TLS_MIN_VERSION=1.2
